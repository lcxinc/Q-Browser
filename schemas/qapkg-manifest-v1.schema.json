{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q-browser.dev/schemas/qapkg-manifest-v1.schema.json",
  "title": "Q-Browser package manifest v1",
  "x-maxManifestBytes": 1048576,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appId",
    "version",
    "entryPoint",
    "runtime",
    "imports",
    "permissions",
    "limits",
    "routes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "appId": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?=.{1,253}$)(?=[^.]{1,63}(?:\\.|$))[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.(?=[^.]{1,63}(?:\\.|$))[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "entryPoint": {
      "type": "string",
      "maxLength": 120,
      "x-maxWindowsComponentUtf16Units": 240,
      "x-windowsPathInvariants": [
        "segments do not end in dot or space",
        "Win32 device basenames are forbidden case-insensitively"
      ],
      "pattern": "^(?![\\s\\S]*(?:\uD83F\uDFFE|\uD83F\uDFFF|\uD87F\uDFFE|\uD87F\uDFFF|\uD8BF\uDFFE|\uD8BF\uDFFF|\uD8FF\uDFFE|\uD8FF\uDFFF|\uD93F\uDFFE|\uD93F\uDFFF|\uD97F\uDFFE|\uD97F\uDFFF|\uD9BF\uDFFE|\uD9BF\uDFFF|\uD9FF\uDFFE|\uD9FF\uDFFF|\uDA3F\uDFFE|\uDA3F\uDFFF|\uDA7F\uDFFE|\uDA7F\uDFFF|\uDABF\uDFFE|\uDABF\uDFFF|\uDAFF\uDFFE|\uDAFF\uDFFF|\uDB3F\uDFFE|\uDB3F\uDFFF|\uDB7F\uDFFE|\uDB7F\uDFFF|\uDBBF\uDFFE|\uDBBF\uDFFF|\uDBFF\uDFFE|\uDBFF\uDFFF))(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])[ .]*(?:\\.|/|$))(?:(?:[^\\x00-\\x1F\\x7F-\\x9F<>:\"/\\\\|?*%#\\uD800-\\uDFFF\\uFDD0-\\uFDEF\\uFFFE\\uFFFF])|(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]))*(?:(?:[^\\x00-\\x1F\\x7F-\\x9F<>:\"/\\\\|?*%# .\\uD800-\\uDFFF\\uFDD0-\\uFDEF\\uFFFE\\uFFFF])|(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]))/)*(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])[ .]*(?:\\.|$))(?:(?:[^\\x00-\\x1F\\x7F-\\x9F<>:\"/\\\\|?*%#\\uD800-\\uDFFF\\uFDD0-\\uFDEF\\uFFFE\\uFFFF])|(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]))*\\.qml$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "x-runtimeInvariants": ["minVersion.major <= maxVersion.major"],
      "required": ["minVersion", "maxVersion"],
      "properties": {
        "minVersion": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "maxVersion": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(0|[1-9]\\d*)\\.x$"
        }
      }
    },
    "imports": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "QtQuick",
          "QtQuick.Controls",
          "QtQuick.Layouts",
          "Company.Design",
          "Company.Runtime"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hosts", "methods"],
          "properties": {
            "hosts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^(?=.{1,253}$)(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?![0-9.]+$)(?!(?:(?:[0-9]+|0[xX][0-9A-Fa-f]+)(?:\\.(?:[0-9]+|0[xX][0-9A-Fa-f]+)){0,3})$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*)$"
              }
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["GET", "POST", "PUT"]
              }
            }
          }
        },
        "storage": {
          "type": "string",
          "const": "app-private"
        },
        "clipboardWrite": {
          "type": "boolean"
        },
        "clipboardRead": {
          "type": "string",
          "const": "user-gesture"
        },
        "fileOpen": {
          "type": "string",
          "const": "user-brokered"
        },
        "process": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageBytes", "memoryMiB", "processes"],
      "properties": {
        "packageBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 384
        },
        "processes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 2048,
        "pattern": "^(?:/|/(?:[A-Za-z0-9_.~-]+|:[A-Za-z_][A-Za-z0-9_]*)(?:/(?:[A-Za-z0-9_.~-]+|:[A-Za-z_][A-Za-z0-9_]*))*)$"
      }
    }
  }
}
