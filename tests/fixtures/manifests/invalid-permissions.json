{
  "schemaVersion": 1,
  "appId": "com.qbrowser.pilot",
  "version": "1.0.0",
  "entryPoint": "qml/Main.qml",
  "runtime": {"minVersion": "1.0.0", "maxVersion": "1.x"},
  "imports": ["QtQuick"],
  "permissions": {
    "network": [],
    "storage": "shared",
    "clipboardWrite": "yes",
    "clipboardRead": "always",
    "fileOpen": "raw",
    "process": true
  },
  "limits": {"packageBytes": 1024, "memoryMiB": 64, "processes": 1},
  "routes": ["/login"]
}
