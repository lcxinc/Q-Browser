{
  "name": "@q-browser/tools",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mock-api",
    "migrator"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean --workspace @q-browser/migrator && tsc -b --force && npm rebuild --workspace @q-browser/migrator --ignore-scripts",
    "test": "npm run build && vitest run --pool=threads --maxWorkers=1",
    "lint": "tsc -b --pretty false && tsc -p migrator/tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "entities": "8.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "css-tree": "3.2.1",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
